      ]
    },
    {
      "name": "Errors and security",
      "description": "Error responses. Every error has the same JSON body: timestamp, status, error, message, path. Independent of the other folders.",
      "item": [
        {
          "name": "No credentials (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets"
              ],
              "raw": "{{baseUrl}}/pets"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Asks for Basic auth\", () => pm.response.to.have.header(\"WWW-Authenticate\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
