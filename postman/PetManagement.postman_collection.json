            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners",
                "{{ownerId}}"
              ],
              "raw": "{{baseUrl}}/owners/{{ownerId}}"
            }
          },
          "event": [
            {
              "listen": "test",
