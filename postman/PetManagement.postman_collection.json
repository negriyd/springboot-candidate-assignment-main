        {
          "name": "Delete pet",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                "{{petId}}"
              ],
              "raw": "{{baseUrl}}/pets/{{petId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted pet (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                "{{petId}}"
              ],
              "raw": "{{baseUrl}}/pets/{{petId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
